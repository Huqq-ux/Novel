# ============================================
# Novel Docker 部署环境变量配置文件
# 复制此文件为 .env 并填入实际值:
#   cp .env.docker .env
# ============================================

# -------- 数据库 --------
DB_URL=jdbc:mysql://mysql:3306/novel?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=请修改为你的数据库密码

# -------- Redis --------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=请修改为你的Redis密码

# -------- JWT --------
JWT_SECRET=请生成一个随机密钥（至少32字符）
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# -------- CORS --------
CORS_ALLOWED_ORIGINS=http://localhost

# -------- DeepSeek API --------
DEEPSEEK_API_KEY=你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# -------- AI 服务 --------
AI_SERVICE_PORT=8001

# -------- 数据库 root 密码（MySQL 容器初始化用） --------
MYSQL_ROOT_PASSWORD=请修改为你的数据库密码
